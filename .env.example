SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Public URL of the deployed app (sitemap, billing redirects, invoice callbacks)
VITE_APP_URL=

# Optional integrations — fill in as needed
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint overrides for the AI signal parser
OPENAI_BASE_URL=
OPENAI_MODEL=
RESEND_API_KEY=
EMAIL_FROM="Notifications <onboarding@resend.dev>"
# Bot-less Telegram: MTProto login/notifications use the account's own session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENC_KEY=
EXCHANGE_ENCRYPTION_KEY=
BSC_USDT_ADDRESS=
CRON_SECRET=
PRICE_RELAY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
PAYMENT_WEBHOOK_SECRET=
# Supabase auth hook (send-email) signature secret
SUPABASE_AUTH_HOOK_SECRET=
# Optional abuse-IP screening on public signup (https://www.abuseipdb.com/)
ABUSEIPDB_API_KEY=
# Optional whale-watch market intel (https://coinlobster.com/) — public endpoint used when unset
COINLOBSTER_API_KEY=

# --- Trust Wallet crypto payment (USDT TRC-20, no Stripe needed) ---
# Operator's Trust Wallet USDT (TRC-20) receive address (starts with T...)
USDT_TRON_ADDRESS=
# Free TronGrid API key (https://www.trongrid.io/) — recommended for reliable on-chain verify
TRONGRID_API_KEY=

# --- Worker tuning (all optional; defaults shown) ---
# Base URL the production worker uses to reach the app's internal hooks
APP_INTERNAL_URL=http://localhost:3000
WORKER_INTERVAL_MS=5000
WORKER_CLAIM_LIMIT=10
# Set to 1 to run a single worker tick and exit (smoke test)
WORKER_DRY_RUN=
CHANNEL_POLL_INTERVAL_MS=30000
CRYPTO_CONFIRM_INTERVAL_MS=60000
# Comma-separated symbols for the WebSocket price feed (defaults to top 20 perps)
WS_WATCHLIST=
