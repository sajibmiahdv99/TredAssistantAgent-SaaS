# @tanstack/zod-adapter (1.167.x) declares a zod@^3 peer while this app pins
# zod@4 — without this flag a fresh `npm ci` / `npm install` fails with
# ERESOLVE. CI and the Dockerfile already pass --legacy-peer-deps explicitly;
# this file makes local installs behave the same way.
legacy-peer-deps=true
